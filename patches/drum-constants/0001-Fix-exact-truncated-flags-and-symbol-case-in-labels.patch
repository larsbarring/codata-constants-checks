+NIST_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "nist")
+_nist_flags_cache: dict[str, dict[str, tuple[bool, bool]]] = {}
+
+
+def load_nist_flags(version_id: str) -> dict[str, tuple[bool, bool]]:
+    """
+    Return {nist_id: (is_exact, is_truncated)} parsed by nist/repackage.py from
+    NIST's allascii_<year>.txt, which is the authoritative source for both flags.
+    Returns an empty dict if the NIST file for that year is not available.
+    """
+    if version_id not in _nist_flags_cache:
+        path = os.path.join(NIST_DIR, version_id, f"allascii_{version_id}.json")
+        flags = {}
+        if os.path.isfile(path):
+            with open(path, 'r', encoding='utf-8') as f:
+                for e in json.load(f):
+                    if e.get('nist_id'):
+                        flags[e['nist_id']] = (bool(e.get('is_exact')), bool(e.get('is_truncated')))
+        else:
+            logging.warning(f"No NIST source file {path}; is_exact/is_truncated taken from the sheet unchecked")
+        _nist_flags_cache[version_id] = flags
+    return _nist_flags_cache[version_id]
+
+
+def reconcile_nist_flags(version_id: str, nist_id: str, sheet_exact, sheet_truncated) -> tuple[bool, bool]:
+    """
+    Cross-check the sheet's is_exact / is_truncated against the NIST source.
+
+    The NIST file wins on disagreement and a warning is logged, so that a sheet
+    edit (or an import from a CSV that dropped the '...' marker) cannot silently
+    turn a truncated value into one presented as exact.
+    """
+    sheet = (bool(sheet_exact), bool(sheet_truncated))
+    nist = load_nist_flags(version_id).get(nist_id)
+    if nist is None or nist == sheet:
+        return sheet
+    logging.warning(
+        f"v{version_id} {nist_id}: sheet has is_exact={sheet[0]}, is_truncated={sheet[1]}; "
+        f"NIST source has is_exact={nist[0]}, is_truncated={nist[1]}. Using NIST values.")
+    return nist
+
