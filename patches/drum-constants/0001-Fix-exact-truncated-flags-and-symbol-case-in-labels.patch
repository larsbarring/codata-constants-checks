+        refs = [str(lbl) for lbl in graph.objects(s, SKOS.altLabel) if lbl.language == "en"]
+        prefs = [str(lbl) for lbl in graph.objects(s, SKOS.prefLabel) if lbl.language == "en"]
+        if refs and prefs and restore_symbol_case(prefs[0], refs[0]) != prefs[0]:
+            bad.append(f"{prefs[0]!r} (NIST: {refs[0]!r})")
+    assert not bad, "Symbol case altered in prefLabel@en:\n" + "\n".join(sorted(bad))
