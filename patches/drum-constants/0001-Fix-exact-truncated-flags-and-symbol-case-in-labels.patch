+# Case-sensitive symbols that occur in NIST quantity names. Title-casing the
+# curated English label must not alter them: "in u" (unified atomic mass unit)
+# is not "In U", "times c" is not "Times C", "g factor" is not "G Factor",
+# "in HD" (hydrogen deuteride) is not "In Hd", "eV s" is not "eV S".
+SYMBOL_TOKENS = frozenset({
+    # unit symbols
+    "u", "s", "m", "g", "K", "J", "T", "W", "Hz", "MHz", "GHz", "Pa", "kPa",
+    "eV", "keV", "MeV", "GeV", "fm", "kg", "mol",
+    # quantity / particle / molecule symbols
+    "c", "h", "hc", "bar", "pi", "d", "p", "t", "x", "Z", "HD", "HT", "Cs", "Si",
+})
+
+
+def restore_symbol_case(label: str, reference: str | None) -> str:
+    """
+    Return `label` with every symbol from SYMBOL_TOKENS that occurs in
+    `reference` (the NIST-style name) restored to the reference's case.
+
+    Only whole alphabetic tokens are touched, and only tokens that are symbols
+    in the reference, so ordinary title-cased words are left as they are:
+        restore_symbol_case("Rydberg Constant Times Hc In J",
+                            "Rydberg constant times hc in J")
+        -> "Rydberg Constant Times hc In J"
+    """
+    if not label or not reference:
+        return label
+    symbols = {t.lower(): t for t in re.findall(r"[A-Za-z]+", reference) if t in SYMBOL_TOKENS}
+    if not symbols:
+        return label
+    return re.sub(r"[A-Za-z]+", lambda m: symbols.get(m.group(0).lower(), m.group(0)), label)
+
+
