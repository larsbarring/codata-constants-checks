+def _nist_id_map(graph: rdflib.Graph) -> dict:
+    """Map NIST short ids (e.g. 'kjos') to DRUM constant IRIs."""
+    out = {}
+    for c in graph.subjects(RDF.type, MODEL.Constant):
+        for pv in graph.objects(c, SCHEMA.identifier):
+            if (pv, SCHEMA.propertyID, rdflib.Literal("NIST")) in graph:
+                out[str(graph.value(pv, SCHEMA.value))] = c
+    return out
+
+
+@pytest.mark.parametrize("year", VERSIONS)
+def test_truncation_flags_match_nist_source(graph: rdflib.Graph, year: str):
+    """codata:isTruncated true must be asserted exactly where NIST marks a value with '...'."""
+    nist_path = ROOT_DIR / "nist" / year / f"allascii_{year}.json"
+    if not nist_path.exists():
+        pytest.skip(f"no NIST source for {year}")
+    idmap = _nist_id_map(graph)
+    missing, spurious = [], []
+    for entry in json.loads(nist_path.read_text(encoding="utf-8")):
+        constant = idmap.get(entry.get("nist_id"))
+        if constant is None:
+            continue
+        value = rdflib.URIRef(f"{constant}/{year}")
+        if (value, RDF.type, MODEL.ConstantValue) not in graph:
+            continue
+        rdf_truncated = (value, MODEL.isTruncated, rdflib.Literal(True)) in graph
+        if entry.get("is_truncated") and not rdf_truncated:
+            missing.append(entry["nist_id"])
+        if rdf_truncated and not entry.get("is_truncated"):
+            spurious.append(entry["nist_id"])
+    assert not missing, f"{year}: NIST truncated but no codata:isTruncated true: {missing}"
+    assert not spurious, f"{year}: codata:isTruncated true but not truncated in NIST: {spurious}"
+
+
+def test_exact_derived_constants_2022_are_flagged_when_truncated(graph: rdflib.Graph):
+    """
+    R, F, K_J and R_K are exact in the 2019 SI but published truncated. A value
+    flagged isExact must either equal the exact relation or be flagged isTruncated,
+    and a truncated value must agree with the exact one to its last digit.
+    """
+    getcontext().prec = 60
+
+    def literal(cid):
+        return graph.value(CONSTANT[f"{cid}/2022"], MODEL.value)
+
+    k, n_a, e, h = (Decimal(str(literal(c))) for c in
+                    ("BoltzmannConstant", "AvogadroConstant", "ElementaryCharge", "PlanckConstant"))
+    exact = {
+        "MolarGasConstant": k * n_a,
+        "FaradayConstant": n_a * e,
+        "JosephsonConstant": 2 * e / h,
+        "VonKlitzingConstant": h / (e * e),
+    }
+    for cid, value_exact in exact.items():
+        node = CONSTANT[f"{cid}/2022"]
+        published = Decimal(str(literal(cid)))
+        assert (node, MODEL.isExact, rdflib.Literal(True)) in graph, f"{cid} should be exact"
+        if published != value_exact:
+            assert (node, MODEL.isTruncated, rdflib.Literal(True)) in graph, (
+                f"{cid}: published {published} differs from exact {value_exact} but is not flagged truncated")
+            # truncation, not rounding to a different value: |diff| < one unit in the last place
+            ulp = Decimal(1).scaleb(published.as_tuple().exponent)
+            assert abs(published - value_exact) < ulp, f"{cid}: {published} is not a truncation of {value_exact}"
+
