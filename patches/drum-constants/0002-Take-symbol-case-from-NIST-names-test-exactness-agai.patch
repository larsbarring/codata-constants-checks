+def restore_symbol_case(label: str, references) -> str:
+    """
+    Return `label` with every symbol from SYMBOL_TOKENS that occurs in the
+    reference name(s) restored to the case used there.
+
+    `references` is one NIST quantity name or an iterable of them (all NIST
+    names of the constant). Only whole alphabetic tokens are touched, and only
+    tokens that are symbols in a reference, so ordinary title-cased words are
+    left as they are, and a token such as "C" is lowercased only where the
+    NIST name has "c". A token that occurs in the references in more than one
+    case is ambiguous and left unchanged.
         restore_symbol_case("Rydberg Constant Times Hc In J",
                             "Rydberg constant times hc in J")
         -> "Rydberg Constant Times hc In J"
     """
-    if not label or not reference:
+    if not label or not references:
         return label
-    symbols = {t.lower(): t for t in re.findall(r"[A-Za-z]+", reference) if t in SYMBOL_TOKENS}
+    if isinstance(references, str):
+        references = (references,)
+    seen: dict = {}
+    for ref in references:
+        for t in re.findall(r"[A-Za-z]+", ref or ""):
+            if t in SYMBOL_TOKENS:
+                seen.setdefault(t.lower(), set()).add(t)
+    symbols = {k: next(iter(v)) for k, v in seen.items() if len(v) == 1}
     if not symbols:
         return label
     return re.sub(r"[A-Za-z]+", lambda m: symbols.get(m.group(0).lower(), m.group(0)), label)
