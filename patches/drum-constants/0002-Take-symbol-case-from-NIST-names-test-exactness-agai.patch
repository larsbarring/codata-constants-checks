+# Exactness fixed by the SI definitions in force for each adjustment, stated
+# independently of NIST's table formatting. Up to CODATA 2014 the SI fixed c,
+# mu0 (ampere, 1948) and M(12C) (mole), and therefore eps0, Z0 and M_u. CODATA
+# 2018 is the first adjustment in the revised SI (in force 20 May 2019), which
+# fixes h, e, k and N_A, while mu0, eps0, Z0, M_u and M(12C) become measured.
+SI_EXACTNESS = {
+    # constant id: (exact up to 2014, exact from 2018)
+    "SpeedOfLight": (True, True),
+    "ElectromagneticPermeabilityOfVacuum": (True, False),
+    "PermittivityOfVacuum": (True, False),
+    "CharacteristicImpedanceOfVacuum": (True, False),
+    "MolarMassConstant": (True, False),
+    "MolarMassOfCarbon12": (True, False),
+    "PlanckConstant": (False, True),
+    "ElementaryCharge": (False, True),
+    "BoltzmannConstant": (False, True),
+    "AvogadroConstant": (False, True),
+}
+
+
+@pytest.mark.parametrize("cid", sorted(SI_EXACTNESS))
+def test_exactness_follows_si_definitions(graph: rdflib.Graph, cid: str):
+    before_2019, from_2019 = SI_EXACTNESS[cid]
+    checked = []
+    for year in VERSIONS:
+        node = CONSTANT[f"{cid}/{year}"]
+        if (node, RDF.type, MODEL.ConstantValue) not in graph:
+            continue
+        expected = before_2019 if int(year) <= 2014 else from_2019
+        actual = (node, MODEL.isExact, rdflib.Literal(True)) in graph
+        assert actual == expected, f"{cid}/{year}: isExact {actual}, expected {expected} under the SI of that release"
+        checked.append(year)
+    assert "2014" in checked and "2018" in checked, f"{cid}: values for 2014 and 2018 expected, found {checked}"
+
+
+def test_restore_symbol_case_with_several_or_ambiguous_references():
+    # NIST renamed the quantity between releases; symbols from any name count
+    assert restore_symbol_case("Electron Gyromagnetic Ratio Over 2 Pi",
+                               ("electron gyromag. ratio over 2 pi", "electron gyromag. ratio in MHz/T")) == \
+        "Electron Gyromagnetic Ratio Over 2 pi"
+    # a token appearing in two cases is ambiguous and left alone
+    assert restore_symbol_case("Thing In T", ("thing in t",)) == "Thing In t"          # control
+    assert restore_symbol_case("Thing In T", ("thing in t", "thing in T")) == "Thing In T"
